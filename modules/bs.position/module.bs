feature function canonical_to_local
  > Convert a canonical position (using the relative reference frame) into a local position (using the local reference frame).
  authors: "Aksiome"
  contributors: "RacoonJohn"
  created: 2023/10/20 1.20.2
  updated: 2026/10/14 26.3

  context rotation > Rotation used for the conversion.

feature function get_distance_ata
  > Compute the distance between the source entity and the execution position of the function.
  authors: "Aksiome", "Leirof"
  contributors: "RacoonJohn", "Triton365"
  created: 2019/07/14 1.14.3
  updated: 2026/10/14 26.3

  context position > Position to get the distance from.
  context executor > Entity positioned at the reference point.
  input storage: $scale

feature function get_distance_squared_ata
  > Compute the squared distance between the source entity and the execution position of the function.
  authors: "Aksiome", "Leirof"
  contributors: "RacoonJohn
  created: 2019/07/14 1.14.3
  updated: 2026/10/14 26.3

  context position > Position to get the distance from.
  context executor > Entity positioned at the reference point.
  input storage: $scale

feature function get_pos
  > Get the execution position of the function and store the coordinates in 3 scores.
  authors: "Aksiome", "Leirof"
  contributors: "RacoonJohn"
  created: 2017/05/14 1.12
  updated: 2026/10/14 26.3

  input storage: $scale

feature function get_pos_x
  > Get the execution x position of the function and store the coordinate in a score.
  authors: "Aksiome", "Leirof"
  contributors: "RacoonJohn"
  created: 2017/05/14 1.12
  updated: 2026/10/14 26.3

  input storage: $scale

feature function get_pos_y
  > Get the execution y position of the function and store the coordinate in a score.
  authors: "Aksiome", "Leirof"
  contributors: "RacoonJohn"
  created: 2017/05/14 1.12
  updated: 2026/10/14 26.3

  input storage: $scale

feature function get_pos_z
  > Get the execution z position of the function and store the coordinate in a score.
  authors: "Aksiome", "Leirof"
  contributors: "RacoonJohn"
  created: 2017/05/14 1.12
  updated: 2026/10/14 26.3

  input storage: $scale

feature function get_rot
  > Get the execution rotation of the function and store it in 2 scores.
  authors: "Aksiome", "Leirof"
  contributors: "RacoonJohn"
  created: 2017/05/14 1.12
  updated: 2026/10/14 26.3

  input storage: $scale

